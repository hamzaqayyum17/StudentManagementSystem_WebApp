@model StudentManagementSystem.Models.Student
@{
    ViewData["Title"] = "Student Detail";
}
<div class="page-header">
    <div><div class="page-title">Student Detail</div><div class="page-subtitle">Full profile information</div></div>
    <a asp-controller="Student" asp-action="AllStudents" class="btn-back">&larr; Back</a>
</div>
<div class="form-card">
    <div style="display:flex;align-items:center;gap:16px;margin-bottom:24px;padding-bottom:20px;border-bottom:1px solid #f1f5f9;">
        <div style="width:56px;height:56px;background:#eff6ff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:700;color:#4f46e5;">@Model.name?.Substring(0, 1).ToUpper()</div>
        <div>
            <div style="font-size:18px;font-weight:700;color:#0f172a;">@Model.name</div>
            <div style="font-size:13px;color:#64748b;margin-top:2px;">@Model.email</div>
            <span style="background:rgba(245,158,11,0.15);color:#d97706;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600;display:inline-block;margin-top:6px;">Student</span>
        </div>
    </div>
    @foreach (var (label, value) in new[] { ("Student ID", Model.sid), ("Full Name", Model.name), ("City", Model.city), ("Email", Model.email) })
    {
        <div style="display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid #f8fafc;">
            <span style="font-size:13px;color:#64748b;">@label</span>
            <span style="font-size:13px;font-weight:600;color:#0f172a;">@value</span>
        </div>
    }
    <div style="margin-top:20px;display:flex;gap:8px;">
        <a asp-controller="Student" asp-action="Edit" asp-route-sid="@Model.sid" class="btn-primary-custom">Edit Student</a>
        <a asp-controller="Report" asp-action="ResultCard" asp-route-sid="@Model.sid"
               class="btn-primary-custom" style="background:#ef4444;"
               target="_blank">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
            Download Result Card
        </a>
        <a asp-controller="Report" asp-action="ProgressReport"
               asp-route-sid="@Model.sid"
               class="btn-primary-custom" style="background:#8b5cf6;">
            📊 Progress Report
        </a>
        <a asp-controller="Student" asp-action="AllStudents" class="btn-back">Back to List</a>
    </div>
</div>

@using System.Data
@model DataTable
@{
    ViewData["Title"] = "My Courses";
}
<div class="page-header"><div><div class="page-title">My Courses</div><div class="page-subtitle">Your enrolled courses and grades</div></div></div>
@if (Model.Rows.Count == 0)
{
    <div class="table-wrapper"><div class="empty-state"><div class="empty-icon"><svg width="22" height="22" fill="none" stroke="#94a3b8" stroke-width="2" viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" /><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" /></svg></div><div class="empty-title">No courses enrolled yet</div><div class="empty-sub">Contact your admin to get enrolled.</div></div></div>
}
else
{
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:16px;">
        @foreach (DataRow row in Model.Rows)
        {
            var grade = row["grade"].ToString();
            var gc = grade == "A" || grade == "A+" ? "#4f46e5" : grade == "B" || grade == "B+" ? "#0ea5e9" : grade == "C" || grade == "C+" ? "#d97706" : "#ef4444";
            var gb = grade == "A" || grade == "A+" ? "#eff6ff" : grade == "B" || grade == "B+" ? "#e0f2fe" : grade == "C" || grade == "C+" ? "#fef3c7" : "#fef2f2";
            <div class="card" style="border-top:3px solid @gc;">
                <div style="font-size:15px;font-weight:600;color:#0f172a;margin-bottom:12px;">@row["cname"]</div>
                <div style="display:flex;justify-content:space-between;align-items:center;">
                    <span style="font-size:12px;color:#64748b;">Grade</span>
                    <span style="background:@gb;color:@gc;padding:4px 14px;border-radius:20px;font-size:13px;font-weight:700;">@grade</span>
                </div>
            </div>
        }
    </div>
}

@{
    ViewData["Title"] = "Sign In";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    body { background: #0f172a !important; }
    .auth-page { min-height:100vh; display:flex; align-items:center; justify-content:center; padding:24px; background:#0f172a; margin-top:-62px; }
    .auth-box { display:flex; width:100%; max-width:820px; border-radius:18px; overflow:hidden; box-shadow:0 30px 70px rgba(0,0,0,0.5); }
    .auth-left { flex:1; background:linear-gradient(145deg,#1e293b,#0f172a); padding:52px 44px; display:flex; flex-direction:column; justify-content:center; position:relative; overflow:hidden; }
    .auth-left::before { content:''; position:absolute; top:-60px; right:-60px; width:200px; height:200px; background:rgba(99,102,241,0.08); border-radius:50%; }
    .auth-logo { width:100px; height:46px; background:#6366f1; border-radius:13px; display:flex; align-items:center; justify-content:center; font-size:20px; font-weight:700; color:#fff; margin-bottom:32px; }
    .auth-left h1 { color:#fff; font-size:24px; font-weight:700; letter-spacing:-0.5px; margin-bottom:12px; }
    .auth-left p  { color:#64748b; font-size:13.5px; line-height:1.7; margin-bottom:28px; }
    .cred-box { background:rgba(99,102,241,0.08); border:1px solid rgba(99,102,241,0.2); border-radius:10px; padding:16px 18px; }
    .cred-box div { font-size:12.5px; color:#94a3b8; margin-bottom:5px; }
    .cred-box div:last-child { margin-bottom:0; }
    .cred-box span { color:#a5b4fc; font-weight:600; font-family:'DM Mono',monospace; }
    .auth-right { flex:1.2; background:#fff; padding:48px 44px; display:flex; flex-direction:column; justify-content:center; }
    .auth-right h2 { font-size:22px; font-weight:700; color:#0f172a; letter-spacing:-0.5px; margin-bottom:4px; }
    .auth-right .sub { font-size:13px; color:#64748b; margin-bottom:32px; }
    .field-group { margin-bottom:18px; }
    .field-label { display:block; font-size:11.5px; font-weight:600; color:#374151; margin-bottom:6px; text-transform:uppercase; letter-spacing:0.5px; }
    .field-input { width:100%; padding:11px 14px; border:1.5px solid #e2e8f0; border-radius:9px; font-size:14px; font-family:'DM Sans',sans-serif; color:#0f172a; background:#fafafa; transition:all 0.2s; outline:none; }
    .field-input:focus { border-color:#6366f1; box-shadow:0 0 0 3px rgba(99,102,241,0.12); background:#fff; }
    .btn-signin { width:100%; padding:12px; background:#6366f1; color:#fff; border:none; border-radius:9px; font-size:14px; font-weight:600; cursor:pointer; font-family:'DM Sans',sans-serif; transition:all 0.2s; }
    .btn-signin:hover { background:#4f46e5; transform:translateY(-1px); box-shadow:0 6px 16px rgba(99,102,241,0.35); }
    .err-box { background:#fef2f2; border:1px solid #fecaca; color:#dc2626; padding:10px 14px; border-radius:8px; font-size:13px; margin-bottom:20px; display:flex; align-items:center; gap:8px; }
    .divider { display:flex; align-items:center; gap:12px; margin:20px 0; }
    .divider hr { flex:1; border:none; border-top:1px solid #e2e8f0; }
    .divider span { font-size:12px; color:#94a3b8; }
    .teacher-link { display:flex; align-items:center; justify-content:center; gap:6px; padding:10px; border:1.5px solid #e2e8f0; border-radius:9px; color:#374151; text-decoration:none; font-size:13px; font-weight:500; transition:all 0.2s; }
    .teacher-link:hover { border-color:#10b981; color:#059669; background:#f0fdf4; }
</style>
<div class="auth-page">
    <div class="auth-box">
        <div class="auth-left">
            @* <div class="auth-logo">TANOLI</div> *@
            <h1>Welcome to EduTrack! </h1>
            <h2 style="color: #64748b;">Student Management System</h2>
            <p>Sign in to access your dashboard, courses, attendance records and fee information.</p>
            <div class="cred-box">
                <div>Admin &rarr; <span>admin1 / 123</span></div>
                <div>Student &rarr; <span>std1 / 123</span></div>
                <div>Teacher &rarr; <span>t1 / 123</span> (Teacher Login)</div>
            </div>
        </div>
        <div class="auth-right">
            <h2>Sign in to your account</h2>
            <p class="sub">Enter your ID and password to continue</p>
            @if (ViewBag.Error != null) {
                <div class="err-box">
                    <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    @ViewBag.Error
                </div>
            }
            <form method="post">
                <div class="field-group">
                    <label class="field-label">Student ID / Admin ID</label>
                    <input type="text" name="sid" class="field-input" placeholder="e.g. std1 or admin1" autocomplete="username" />
                </div>
                <div class="field-group">
                    <label class="field-label">Password</label>
                    <input type="password" name="password" class="field-input" placeholder="Enter your password" autocomplete="current-password" />
                </div>
                <button type="submit" class="btn-signin">Sign In</button>
            </form>
            <div class="divider"><hr/><span>Teacher Portal</span><hr/></div>
            <a asp-controller="Teacher" asp-action="TeacherSignIn" class="teacher-link">
                <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
                Sign in as Teacher
            </a>
        </div>
    </div>
</div>

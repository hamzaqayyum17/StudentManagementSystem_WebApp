@model StudentManagementSystem.Models.Student
@{
    ViewData["Title"] = "Add Student";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="page-header">
    <div>
        <div class="page-title">Add New Student</div>
        <div class="page-subtitle">Register a new student in the system</div>
    </div>
    <a asp-controller="Student" asp-action="AllStudents" class="btn-back">&larr; Back to Students</a>
</div>
<div class="form-card">
    @if (ViewBag.Msg != null)
    {
        <div class="alert-error">@ViewBag.Msg</div>
    }
    <form method="post">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
            <div class="form-group">
                <label class="form-label">Full Name</label>
                @Html.TextBoxFor(m => m.name, new { @class = "form-control-custom", placeholder = "Ali Hassan" })
                <span class="form-error">@Html.ValidationMessageFor(m => m.name)</span>
            </div>
            <div class="form-group">
                <label class="form-label">City</label>
                @Html.TextBoxFor(m => m.city, new { @class = "form-control-custom", placeholder = "Lahore" })
                <span class="form-error">@Html.ValidationMessageFor(m => m.city)</span>
            </div>
        </div>
        <div class="form-group">
            <label class="form-label">Email Address</label>
            @Html.TextBoxFor(m => m.email, new { @class = "form-control-custom", placeholder = "ali@example.com" })
            <span class="form-error">@Html.ValidationMessageFor(m => m.email)</span>
            <span style="font-size:11px;color:#94a3b8;margin-top:3px;display:block;">Student ID will be auto-generated from email (e.g. ali@@gmail.com → ali)</span>
        </div>
        <div class="form-group">
            <label class="form-label">Password</label>
            @Html.PasswordFor(m => m.password, new { @class = "form-control-custom", placeholder = "Set a password" })
            <span class="form-error">@Html.ValidationMessageFor(m => m.password)</span>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
            <div class="form-group">
                <label class="form-label">Class</label>
                <select name="classId" class="form-control-custom" id="classSelect">
                    <option value="">-- Select Class --</option>
                    @foreach (System.Data.DataRow row in ViewBag.Classes.Rows)
                    {
                        <option value="@row["classId"]">@row["className"]</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Section</label>
                <select name="sectionId" class="form-control-custom" id="sectionSelect">
                    <option value="">-- Select Section --</option>
                </select>
            </div>
        </div>
        <div class="form-group">
            <label class="form-label">Roll Number</label>
            <input type="text" name="rollNumber" class="form-control-custom"
                   placeholder="e.g. 9-A-01" />
        </div>
        <input type="hidden" name="role" value="student" />
        <div style="display:flex;gap:10px;margin-top:8px;">
            <button type="submit" class="btn-primary-custom">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                Add Student
            </button>
            <a asp-controller="Student" asp-action="AllStudents" class="btn-back">Cancel</a>
        </div>
    </form>
</div>
@section Scripts {
    <script>
        document.getElementById("classSelect").addEventListener("change", function () {
            var classId = this.value;
            var secSelect = document.getElementById("sectionSelect");
            secSelect.innerHTML = '<option value="">-- Select Section --</option>';
            if (!classId) return;
            fetch('/Class/GetSections?classId=' + classId)
                .then(r => r.json())
                .then(data => {
                    data.forEach(function (s) {
                        secSelect.innerHTML +=
                            '<option value="' + s.sectionId + '">' + s.sectionName + '</option>';
                    });
                });
        });
    </script>
}
@{
    ViewData["Title"] = "My Dashboard";
}
<div class="page-header">
    <div>
        <div class="page-title">My Dashboard</div>
        <div class="page-subtitle">Welcome back, @ViewBag.Name 👋</div>
    </div>
</div>

<div style="background:linear-gradient(135deg,#1e293b 0%,#0f172a 100%);border-radius:14px;padding:28px 32px;margin-bottom:24px;display:flex;justify-content:space-between;align-items:center;">
    <div>
        <div style="color:#94a3b8;font-size:12px;margin-bottom:6px;">Logged in as</div>
        <div style="color:#fff;font-size:22px;font-weight:700;letter-spacing:-0.5px;">@ViewBag.Name</div>
        <div style="margin-top:10px;">
            <span style="background:rgba(245,158,11,0.2);color:#fcd34d;padding:4px 12px;border-radius:20px;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.5px;">Student</span>
        </div>
    </div>
    <div style="width:60px;height:60px;background:rgba(99,102,241,0.15);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:24px;font-weight:700;color:#a5b4fc;">
        @(ViewBag.Name?.ToString().Substring(0, 1).ToUpper())
    </div>
</div>

<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;">
    <a asp-controller="Student" asp-action="MyCourses" style="text-decoration:none;">
        <div class="card" style="cursor:pointer;border-top:3px solid #6366f1;transition:all 0.2s;" onmouseover="this.style.boxShadow='0 6px 16px rgba(99,102,241,0.12)'" onmouseout="this.style.boxShadow='none'">
            <div style="width:40px;height:40px;background:#eff6ff;border-radius:10px;display:flex;align-items:center;justify-content:center;margin-bottom:12px;">
                <svg width="18" height="18" fill="none" stroke="#6366f1" stroke-width="2" viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" /><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" /></svg>
            </div>
            <div style="font-size:14px;font-weight:600;color:#0f172a;">My Courses</div>
            <div style="font-size:12px;color:#64748b;margin-top:3px;">View grades &rarr;</div>
        </div>
    </a>
    <a asp-controller="Attendance" asp-action="MyAttendance" style="text-decoration:none;">
        <div class="card" style="cursor:pointer;border-top:3px solid #10b981;transition:all 0.2s;" onmouseover="this.style.boxShadow='0 6px 16px rgba(16,185,129,0.12)'" onmouseout="this.style.boxShadow='none'">
            <div style="width:40px;height:40px;background:#f0fdf4;border-radius:10px;display:flex;align-items:center;justify-content:center;margin-bottom:12px;">
                <svg width="18" height="18" fill="none" stroke="#10b981" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
            </div>
            <div style="font-size:14px;font-weight:600;color:#0f172a;">My Attendance</div>
            <div style="font-size:12px;color:#64748b;margin-top:3px;">Check records &rarr;</div>
        </div>
    </a>
    <a asp-controller="Fee" asp-action="MyFees" style="text-decoration:none;">
        <div class="card" style="cursor:pointer;border-top:3px solid #f59e0b;transition:all 0.2s;" onmouseover="this.style.boxShadow='0 6px 16px rgba(245,158,11,0.12)'" onmouseout="this.style.boxShadow='none'">
            <div style="width:40px;height:40px;background:#fffbeb;border-radius:10px;display:flex;align-items:center;justify-content:center;margin-bottom:12px;">
                <svg width="18" height="18" fill="none" stroke="#f59e0b" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23" /><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" /></svg>
            </div>
            <div style="font-size:14px;font-weight:600;color:#0f172a;">My Fees</div>
            <div style="font-size:12px;color:#64748b;margin-top:3px;">Payment status &rarr;</div>
        </div>
    </a>
    <a asp-controller="Student" asp-action="MyProfile" style="text-decoration:none;">
        <div class="card" style="cursor:pointer;border-top:3px solid #8b5cf6;transition:all 0.2s;" onmouseover="this.style.boxShadow='0 6px 16px rgba(139,92,246,0.12)'" onmouseout="this.style.boxShadow='none'">
            <div style="width:40px;height:40px;background:#f5f3ff;border-radius:10px;display:flex;align-items:center;justify-content:center;margin-bottom:12px;">
                <svg width="18" height="18" fill="none" stroke="#8b5cf6" stroke-width="2" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
            </div>
            <div style="font-size:14px;font-weight:600;color:#0f172a;">My Profile</div>
            <div style="font-size:12px;color:#64748b;margin-top:3px;">Account details &rarr;</div>
        </div>
    </a>
</div>

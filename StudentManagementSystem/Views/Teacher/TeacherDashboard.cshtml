@{ ViewData["Title"] = "Teacher Dashboard"; }
<div class="page-header">
    <div><div class="page-title">Teacher Dashboard</div><div class="page-subtitle">Welcome back, @ViewBag.Name 👋</div></div>
    <span style="font-size:12px;color:#94a3b8;">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</span>
</div>
<div style="background:linear-gradient(135deg,#064e3b 0%,#065f46 100%);border-radius:14px;padding:28px 32px;margin-bottom:24px;display:flex;justify-content:space-between;align-items:center;">
    <div>
        <div style="color:#6ee7b7;font-size:12px;margin-bottom:6px;">Logged in as Teacher</div>
        <div style="color:#fff;font-size:22px;font-weight:700;letter-spacing:-0.5px;">@ViewBag.Name</div>
        <div style="margin-top:10px;"><span style="background:rgba(16,185,129,0.2);color:#6ee7b7;padding:4px 12px;border-radius:20px;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.5px;">Teacher</span></div>
    </div>
    <div style="width:60px;height:60px;background:rgba(16,185,129,0.15);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:24px;font-weight:700;color:#6ee7b7;">@(ViewBag.Name?.ToString().Substring(0,1).ToUpper())</div>
</div>
<div class="stat-grid">
    <div class="stat-card" style="border-top:3px solid #10b981;">
        <div class="stat-card-label">Today's Attendance</div>
        <div class="stat-card-value green">@ViewBag.TodayAttendance</div>
        <div style="font-size:11px;color:#94a3b8;margin-top:8px;">Records marked today</div>
    </div>
    <div class="stat-card" style="border-top:3px solid #6366f1;">
        <div class="stat-card-label">Total Students</div>
        <div class="stat-card-value blue">@ViewBag.TotalStudents</div>
        <div style="font-size:11px;color:#94a3b8;margin-top:8px;">Registered students</div>
    </div>
</div>
<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
    <div class="card">
        <div style="font-size:14px;font-weight:600;margin-bottom:16px;">⚡ Quick Actions</div>
        <div style="display:flex;flex-direction:column;gap:8px;">
            <a asp-controller="Attendance" asp-action="MarkAttendance" class="btn-primary-custom btn-success" style="justify-content:flex-start;">
                <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/></svg>
                Mark Today's Attendance
            </a>
            <a asp-controller="Attendance" asp-action="ViewAttendance" class="btn-primary-custom" style="justify-content:flex-start;">
                <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                View Attendance Records
            </a>
        </div>
    </div>
    <div class="card">
        <div style="font-size:14px;font-weight:600;margin-bottom:16px;">📅 Today</div>
        <div style="display:flex;flex-direction:column;gap:0;">
            <div style="display:flex;justify-content:space-between;padding:11px 0;border-bottom:1px solid #f1f5f9;"><span style="font-size:13px;color:#64748b;">Date</span><span style="font-size:13px;font-weight:600;">@DateTime.Now.ToString("dd MMM yyyy")</span></div>
            <div style="display:flex;justify-content:space-between;padding:11px 0;"><span style="font-size:13px;color:#64748b;">Attendance marked</span><span style="font-size:13px;font-weight:600;color:#10b981;">@ViewBag.TodayAttendance records</span></div>
        </div>
    </div>
</div>

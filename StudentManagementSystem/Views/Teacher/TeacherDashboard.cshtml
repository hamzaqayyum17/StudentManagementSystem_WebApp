@{
    ViewData["Title"] = "Teacher Dashboard";
}

<div class="page-header">
    <div>
        <div class="page-title">Teacher Dashboard</div>
        <div class="page-subtitle">Welcome back, @ViewBag.Name 👋</div>
    </div>
    <span style="font-size:12px;color:#94a3b8;">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</span>
</div>

@* {{!-- Welcome Banner --}} *@
<div style="background:linear-gradient(135deg,#064e3b 0%,#065f46 100%);border-radius:14px;padding:28px 32px;margin-bottom:24px;display:flex;justify-content:space-between;align-items:center;">
    <div>
        <div style="color:#6ee7b7;font-size:12px;margin-bottom:6px;">Logged in as Teacher</div>
        <div style="color:#fff;font-size:22px;font-weight:700;letter-spacing:-0.5px;">@ViewBag.Name</div>
        <div style="margin-top:10px;">
            <span style="background:rgba(16,185,129,0.2);color:#6ee7b7;padding:4px 12px;border-radius:20px;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.5px;">Teacher</span>
        </div>
    </div>
    <div style="width:60px;height:60px;background:rgba(16,185,129,0.15);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:24px;font-weight:700;color:#6ee7b7;">
        @(ViewBag.Name?.ToString().Substring(0, 1).ToUpper())
    </div>
</div>

@* {{!-- Stat Cards --}} *@
<div class="stat-grid" style="margin-bottom:24px;">
    <div class="stat-card" style="border-top:3px solid #10b981;">
        <div class="stat-card-label">Today's Attendance</div>
        <div class="stat-card-value green">@ViewBag.TodayAttendance</div>
        <div style="font-size:11px;color:#94a3b8;margin-top:8px;">Records marked today</div>
    </div>
    <div class="stat-card" style="border-top:3px solid #6366f1;">
        <div class="stat-card-label">Total Students</div>
        <div class="stat-card-value blue">@ViewBag.TotalStudents</div>
        <div style="font-size:11px;color:#94a3b8;margin-top:8px;">Registered students</div>
    </div>
</div>

@* {{!-- Main Content --}} *@
<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">

    @* {{!-- Attendance via Google Sheet --}} *@
    <div class="card">
        <div style="font-size:14px;font-weight:600;margin-bottom:16px;">
            <svg width="15" height="15" fill="none" stroke="#10b981" stroke-width="2" viewBox="0 0 24 24" style="vertical-align:middle;margin-right:6px;">
                <path d="M9 11l3 3L22 4"/>
                <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
            </svg>
            Mark / View Attendance
        </div>

        <div class="form-group">
            <label class="form-label">Select Class</label>
            <select id="classSelect" class="form-control-custom" onchange="onClassChange(this.value)">
                <option value="">-- Choose a Class --</option>
                @foreach (System.Data.DataRow row in ViewBag.Classes.Rows)
                {
                    <option value="@row["classId"]">@row["className"]</option>
                }
            </select>
        </div>

        <div id="sheetArea" style="display:none;gap:10px;flex-wrap:wrap;margin-top:8px;">
            <button onclick="openSheet()"
                    class="btn-primary-custom"
                    style="background:#0ea5e9;width:100%;justify-content:center;">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                    <polyline points="15 3 21 3 21 9"/>
                    <line x1="10" y1="14" x2="21" y2="3"/>
                </svg>
                Open Google Sheet
            </button>
            <button onclick="syncClass()"
                    class="btn-primary-custom btn-success"
                    style="width:100%;justify-content:center;">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <polyline points="23 4 23 10 17 10"/>
                    <polyline points="1 20 1 14 7 14"/>
                    <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
                </svg>
                Sync to Database
            </button>
        </div>

        <div id="noSheetMsg" style="display:none;margin-top:10px;background:#fef2f2;border:1px solid #fecaca;color:#dc2626;padding:10px 14px;border-radius:8px;font-size:13px;">
            No Google Sheet linked for this class. Please contact the admin.
        </div>
    </div>

    @* {{!-- Today Info --}} *@
    <div class="card">
        <div style="font-size:14px;font-weight:600;margin-bottom:16px;">
            <svg width="15" height="15" fill="none" stroke="#6366f1" stroke-width="2" viewBox="0 0 24 24" style="vertical-align:middle;margin-right:6px;">
                <rect x="3" y="4" width="18" height="18" rx="2"/>
                <line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
            Today
        </div>
        <div style="display:flex;flex-direction:column;gap:0;">
            <div style="display:flex;justify-content:space-between;padding:11px 0;border-bottom:1px solid #f1f5f9;">
                <span style="font-size:13px;color:#64748b;">Date</span>
                <span style="font-size:13px;font-weight:600;">@DateTime.Now.ToString("dd MMM yyyy")</span>
            </div>
            <div style="display:flex;justify-content:space-between;padding:11px 0;border-bottom:1px solid #f1f5f9;">
                <span style="font-size:13px;color:#64748b;">Day</span>
                <span style="font-size:13px;font-weight:600;">@DateTime.Now.ToString("dddd")</span>
            </div>
            <div style="display:flex;justify-content:space-between;padding:11px 0;">
                <span style="font-size:13px;color:#64748b;">Attendance Marked</span>
                <span style="font-size:13px;font-weight:600;color:#10b981;">@ViewBag.TodayAttendance records</span>
            </div>
        </div>

        <div style="margin-top:16px;padding-top:16px;border-top:1px solid #f1f5f9;">
            <div style="font-size:12px;font-weight:600;color:#374151;margin-bottom:10px;">How It Works:</div>
            <div style="display:flex;flex-direction:column;gap:8px;">
                <div style="display:flex;align-items:flex-start;gap:8px;">
                    <div style="width:18px;height:18px;background:#0ea5e9;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:10px;font-weight:700;flex-shrink:0;">1</div>
                    <div style="font-size:12px;color:#64748b;">Select a class from the left</div>
                </div>
                <div style="display:flex;align-items:flex-start;gap:8px;">
                    <div style="width:18px;height:18px;background:#0ea5e9;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:10px;font-weight:700;flex-shrink:0;">2</div>
                    <div style="font-size:12px;color:#64748b;"><strong>Open Google Sheet</strong> — mark attendance there</div>
                </div>
                <div style="display:flex;align-items:flex-start;gap:8px;">
                    <div style="width:18px;height:18px;background:#10b981;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:10px;font-weight:700;flex-shrink:0;">3</div>
                    <div style="font-size:12px;color:#64748b;"><strong>Sync to Database</strong> — import into system</div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
<script>
    var sheetUrl = '';

    function onClassChange(classId) {
        var sheetArea = document.getElementById('sheetArea');
        var noSheetMsg = document.getElementById('noSheetMsg');
        sheetArea.style.display = 'none';
        noSheetMsg.style.display = 'none';

        if (!classId) return;

        fetch('/Attendance/GetSheetLink?classId=' + classId)
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    sheetUrl = data.url;
                    sheetArea.style.display = 'flex';
                } else {
                    sheetUrl = '';
                    noSheetMsg.style.display = 'block';
                }
            });
    }

    function openSheet() {
        if (sheetUrl) window.open(sheetUrl, '_blank');
    }

    function syncClass() {
        var classId = document.getElementById('classSelect').value;
        if (!classId) { alert('Please select a class first!'); return; }
        if (confirm('Sync attendance from Google Sheet to database?')) {
            window.location.href = '/Attendance/SyncByClass?classId=' + classId;
        }
    }
</script>
}

@model StudentManagementSystem.Models.Teacher
@{ ViewData["Title"] = "Teacher Detail"; }
<div class="page-header"><div><div class="page-title">Teacher Detail</div><div class="page-subtitle">Full profile information</div></div><a asp-controller="Teacher" asp-action="AllTeachers" class="btn-back">&larr; Back</a></div>
<div class="form-card">
    <div style="display:flex;align-items:center;gap:16px;margin-bottom:24px;padding-bottom:20px;border-bottom:1px solid #f1f5f9;">
        <div style="width:56px;height:56px;background:#f0fdf4;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:700;color:#059669;">@Model.name?.Substring(0,1).ToUpper()</div>
        <div>
            <div style="font-size:18px;font-weight:700;">@Model.name</div>
            <div style="font-size:13px;color:#64748b;margin-top:2px;">@Model.email</div>
            <span style="background:#f0fdf4;color:#059669;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600;display:inline-block;margin-top:6px;">@Model.subject</span>
        </div>
    </div>
    @foreach (var (label, value) in new[] { ("Teacher ID", Model.tid), ("Full Name", Model.name), ("City", Model.city), ("Email", Model.email), ("Subject", Model.subject) })
    {
        <div style="display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid #f8fafc;"><span style="font-size:13px;color:#64748b;">@label</span><span style="font-size:13px;font-weight:600;">@value</span></div>
    }
    <div style="margin-top:20px;display:flex;gap:8px;">
        <a asp-controller="Teacher" asp-action="EditTeacher" asp-route-tid="@Model.tid" class="btn-primary-custom btn-success">Edit Teacher</a>
        <a asp-controller="Teacher" asp-action="AllTeachers" class="btn-back">Back to List</a>
    </div>
</div>

@model List<StudentManagementSystem.Models.Teacher>
@{
    ViewData["Title"] = "Teachers";
}
<div class="page-header">
    <div><div class="page-title">Teachers</div><div class="page-subtitle">@Model.Count teacher(s) registered</div></div>
    <a asp-controller="Teacher" asp-action="AddTeacher" class="btn-primary-custom btn-success"><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>Add Teacher</a>
</div>
<div class="table-wrapper">
    <div class="table-toolbar"><div><div class="table-title">All Teachers</div><div class="table-count">@Model.Count records</div></div></div>
    <table class="data-table">
        <thead><tr><th>ID</th><th>Name</th><th>City</th><th>Subject</th><th>Actions</th></tr></thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td style="font-family:'DM Mono',monospace;font-size:12px;color:#94a3b8;">@t.tid</td>
                    <td><div style="display:flex;align-items:center;gap:10px;"><div style="width:32px;height:32px;background:#f0fdf4;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:#059669;">@t.name.Substring(0, 1).ToUpper()</div><span style="font-weight:500;">@t.name</span></div></td>
                    <td style="color:#64748b;">@t.city</td>
                    <td><span style="background:#f0fdf4;color:#059669;padding:3px 10px;border-radius:20px;font-size:12px;font-weight:600;">@t.subject</span></td>
                    <td><div style="display:flex;gap:6px;"><a asp-controller="Teacher" asp-action="DetailTeacher" asp-route-tid="@t.tid" class="btn-edit">View</a><a asp-controller="Teacher" asp-action="EditTeacher" asp-route-tid="@t.tid" class="btn-edit" style="background:#f0fdf4;color:#15803d;">Edit</a><a asp-controller="Teacher" asp-action="DeleteTeacher" asp-route-tid="@t.tid" class="btn-delete" onclick="return confirm('Delete @t.name?')">Delete</a></div></td>
                </tr>
            }
        </tbody>
    </table>
</div>

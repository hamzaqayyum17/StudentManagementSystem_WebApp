@model List<StudentManagementSystem.Models.Attendance>
@{
    ViewData["Title"] = "Attendance Records";
}
<div class="page-header">
    <div><div class="page-title">Attendance Records</div><div class="page-subtitle">@Model.Count record(s) found</div></div>
    <a asp-controller="Attendance" asp-action="MarkAttendance" class="btn-primary-custom btn-success">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M9 11l3 3L22 4" /></svg>
        Mark Attendance
    </a>
</div>
<div class="table-wrapper">
    <div class="table-toolbar"><div><div class="table-title">All Records</div><div class="table-count">@Model.Count records</div></div></div>
    @if (Model.Count == 0)
    {
        <div class="empty-state"><div class="empty-icon"><svg width="22" height="22" fill="none" stroke="#94a3b8" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="3" y1="10" x2="21" y2="10" /></svg></div><div class="empty-title">No attendance records</div><div class="empty-sub">Mark attendance to see records here.</div></div>
    }
    else
    {
        <table class="data-table">
            <thead><tr><th>#</th><th>Student</th><th>Date</th><th>Status</th><th>Marked By</th>@if (Context.Session.GetString("role")=="admin"){
                <th>Actions</th>
            }
        </tr></thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td style="font-size:12px;color:#94a3b8;">@a.aid</td>
                    <td style="font-weight:500;">@a.studentName</td>
                    <td style="color:#64748b;font-family:'DM Mono',monospace;font-size:13px;">@a.date.ToString("dd MMM yyyy")</td>
                    <td>
                        @if (a.status == "Present")
                        {
                            <span class="badge-present">✓ Present</span>
                        }
                        else if (a.status == "Absent")
                        {

                            <span class="badge-absent">✗ Absent</span>
                        }
                        else
                        {

                            <span class="badge-late">⏰ Late</span>
                        }
                    </td>
                    <td style="color:#64748b;font-size:13px;">@a.markedBy</td>
                    @if (Context.Session.GetString("role") == "admin")
                    {
                        <td><a asp-controller="Attendance" asp-action="DeleteAttendance" asp-route-aid="@a.aid" class="btn-delete" onclick="return confirm('Delete this record?')">Delete</a></td>
                    }
                </tr>
            }
        </tbody>
    </table>
}
</div>

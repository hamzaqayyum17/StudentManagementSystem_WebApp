@using System.Data
@model List<StudentManagementSystem.Models.Attendance>
@{
    ViewData["Title"] = "Attendance";
}

<div class="page-header">
    <div>
        <div class="page-title">Attendance</div>
        <div class="page-subtitle">Select a class and manage attendance via Google Sheet</div>
    </div>
</div>

<div class="form-card" style="max-width:480px;">

    <div class="form-group">
        <label class="form-label">Select Class</label>
        <select id="classSelect" class="form-control-custom" onchange="onClassChange(this.value)">
            <option value="">-- Choose a Class --</option>
            @foreach (System.Data.DataRow row in ViewBag.Classes.Rows)
            {
                <option value="@row["classId"]">@row["className"]</option>
            }
        </select>
    </div>

    <div id="sheetArea" style="display:none;margin-top:8px;gap:10px;flex-wrap:wrap;">
        <button onclick="openSheet()" id="btnOpenSheet"
                class="btn-primary-custom"
                style="background:#0ea5e9;">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                <polyline points="15 3 21 3 21 9"/>
                <line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
            Open Google Sheet
        </button>

        <button onclick="syncClass()" id="btnSync"
                class="btn-primary-custom btn-success">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <polyline points="23 4 23 10 17 10"/>
                <polyline points="1 20 1 14 7 14"/>
                <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
            </svg>
            Sync to Database
        </button>
    </div>

    <div id="noSheetMsg" style="display:none;margin-top:12px;background:#fef2f2;border:1px solid #fecaca;color:#dc2626;padding:10px 14px;border-radius:8px;font-size:13px;">
        No Google Sheet linked for this class. Please contact the admin.
    </div>

</div>

<div style="margin-top:32px;padding:24px;background:#f8fafc;border-radius:14px;border:1px solid #f1f5f9;max-width:480px;">
    <div style="font-size:13px;font-weight:600;color:#374151;margin-bottom:12px;">How It Works:</div>
    <div style="display:flex;flex-direction:column;gap:10px;">
        <div style="display:flex;align-items:flex-start;gap:10px;">
            <div style="width:22px;height:22px;background:#0ea5e9;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:11px;font-weight:700;flex-shrink:0;">1</div>
            <div style="font-size:13px;color:#64748b;">Select a class from the dropdown above</div>
        </div>
        <div style="display:flex;align-items:flex-start;gap:10px;">
            <div style="width:22px;height:22px;background:#0ea5e9;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:11px;font-weight:700;flex-shrink:0;">2</div>
            <div style="font-size:13px;color:#64748b;"><strong>Open Google Sheet</strong> — view or mark attendance directly in the sheet</div>
        </div>
        <div style="display:flex;align-items:flex-start;gap:10px;">
            <div style="width:22px;height:22px;background:#10b981;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:11px;font-weight:700;flex-shrink:0;">3</div>
            <div style="font-size:13px;color:#64748b;"><strong>Sync to Database</strong> — import attendance from the sheet into the system</div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    var sheetUrl = '';

    function onClassChange(classId) {
        var sheetArea = document.getElementById('sheetArea');
        var noSheetMsg = document.getElementById('noSheetMsg');
        sheetArea.style.display = 'none';
        noSheetMsg.style.display = 'none';

        if (!classId) return;

        fetch('/Attendance/GetSheetLink?classId=' + classId)
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    sheetUrl = data.url;
                    sheetArea.style.display = 'flex';
                    noSheetMsg.style.display = 'none';
                } else {
                    sheetUrl = '';
                    sheetArea.style.display = 'none';
                    noSheetMsg.style.display = 'block';
                }
            });
    }

    function openSheet() {
        if (sheetUrl) window.open(sheetUrl, '_blank');
    }

    function syncClass() {
        var classId = document.getElementById('classSelect').value;
        if (!classId) { alert('Please select a class first!'); return; }
        if (confirm('Sync attendance from Google Sheet to database?')) {
            window.location.href = '/Attendance/SyncByClass?classId=' + classId;
        }
    }
</script>
}

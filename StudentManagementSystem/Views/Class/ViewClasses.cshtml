@model List<StudentManagementSystem.Models.Class>
@{
    ViewData["Title"] = "Classes";
}
<div class="page-header">
    <div>
        <div class="page-title">Classes</div>
        <div class="page-subtitle">@Model.Count class(es) registered</div>
    </div>
    <a asp-controller="Class" asp-action="AddClass" class="btn-primary-custom">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
        Add Class
    </a>
</div>

<div class="table-wrapper">
    <div class="table-toolbar">
        <div>
            <div class="table-title">All Classes</div>
            <div class="table-count">@Model.Count records</div>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon">
                <svg width="22" height="22" fill="none" stroke="#94a3b8" stroke-width="2" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /></svg>
            </div>
            <div class="empty-title">No classes found</div>
            <div class="empty-sub">Add a new class to get started.</div>
        </div>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Class Name</th>
                    <th>Sections</th>
                    <th>Students</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td style="font-family:'DM Mono',monospace;font-size:12px;color:#94a3b8;">@c.classId</td>
                        <td>
                            <div style="display:flex;align-items:center;gap:10px;">
                                <div style="width:34px;height:34px;background:#eff6ff;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;color:#4f46e5;">
                                    @c.className.Substring(0, 1)
                                </div>
                                <span style="font-weight:600;">@c.className</span>
                            </div>
                        </td>
                        <td>
                            <a asp-controller="Class" asp-action="ViewSections" asp-route-classId="@c.classId" class="btn-edit">
                                View Sections
                            </a>
                        </td>
                        <td>
                            <a asp-controller="Class" asp-action="ClassStudents" asp-route-classId="@c.classId" class="btn-paid">
                                View Students
                            </a>
                        </td>
                        <td>
                            <div style="display:flex;gap:6px;">
                                <a asp-controller="Class" asp-action="EditClass" asp-route-classId="@c.classId" class="btn-edit" style="background:#f0fdf4;color:#15803d;">Edit</a>
                                <a asp-controller="Class" asp-action="DeleteClass" asp-route-classId="@c.classId" class="btn-delete"
                                   onclick="return confirm('Delete @c.className? All sections will also be deleted!')">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
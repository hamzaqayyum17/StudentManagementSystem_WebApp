@model List<StudentManagementSystem.Models.Fee>
@{ ViewData["Title"] = "Unpaid Fees"; }
<div class="page-header">
    <div><div class="page-title">Unpaid Fees</div><div class="page-subtitle">@Model.Count pending payment(s)</div></div>
    <a asp-controller="Fee" asp-action="ViewFees" class="btn-back">&larr; All Fees</a>
</div>
@if (Model.Count > 0) {
    var total = Model.Sum(f => f.amount);
    <div class="stat-card" style="border-top:3px solid #ef4444;max-width:300px;margin-bottom:20px;">
        <div class="stat-card-label">Total Unpaid Amount</div>
        <div class="stat-card-value red" style="font-size:24px;">Rs. @total.ToString("N0")</div>
    </div>
}
<div class="table-wrapper">
    <div class="table-toolbar"><div><div class="table-title">Unpaid Fee List</div><div class="table-count">@Model.Count records</div></div></div>
    @if (Model.Count == 0) {
        <div class="empty-state"><div class="empty-icon"><svg width="22" height="22" fill="none" stroke="#94a3b8" stroke-width="2" viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/></svg></div><div class="empty-title">All fees are paid! 🎉</div></div>
    } else {
        <table class="data-table">
            <thead><tr><th>#</th><th>Student</th><th>Month</th><th>Amount</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var f in Model) {
                    <tr>
                        <td style="font-size:12px;color:#94a3b8;">@f.fid</td>
                        <td style="font-weight:500;">@f.studentName</td>
                        <td style="color:#64748b;">@f.month</td>
                        <td style="font-family:'DM Mono',monospace;font-weight:600;color:#ef4444;">Rs. @f.amount.ToString("N0")</td>
                        <td><a asp-controller="Fee" asp-action="MarkPaid" asp-route-fid="@f.fid" class="btn-paid" onclick="return confirm('Mark as Paid?')">✓ Mark Paid</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@model StudentManagementSystem.Models.Course
@{
    ViewData["Title"] = "Edit Course";
}
<div class="page-header"><div><div class="page-title">Edit Course</div><div class="page-subtitle">Update course details</div></div><a asp-controller="Course" asp-action="ViewCourses" class="btn-back">&larr; Back</a></div>
<div class="form-card">
    <form method="post">
        @Html.HiddenFor(m => m.cid)
        <div class="form-group"><label class="form-label">Course Name</label>@Html.TextBoxFor(m => m.cname, new { @class = "form-control-custom" })</div>
        <div class="form-group"><label class="form-label">Credit Hours</label>@Html.TextBoxFor(m => m.creditHours, new { @class = "form-control-custom" })</div>
        <div style="display:flex;gap:10px;margin-top:8px;"><button type="submit" class="btn-primary-custom">Save Changes</button><a asp-controller="Course" asp-action="ViewCourses" class="btn-back">Cancel</a></div>
    </form>
</div>
